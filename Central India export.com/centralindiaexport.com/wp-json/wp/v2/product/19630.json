{"id":19630,"date":"2024-07-29T15:58:29","date_gmt":"2024-07-29T15:58:29","guid":{"rendered":"https:\/\/centralindiaexport.com\/?post_type=product&#038;p=19630"},"modified":"2024-07-29T16:03:56","modified_gmt":"2024-07-29T16:03:56","slug":"fluorescein-sodium-injection-10-and-20","status":"publish","type":"product","link":"https:\/\/centralindiaexport.com\/product\/fluorescein-sodium-injection-10-and-20\/","title":{"rendered":"Fluorescein Sodium Injection 10% and 20%"},"content":{"rendered":"<h3>Specification Table for Fluorescein Sodium Injection<\/h3>\n<table>\n<thead>\n<tr>\n<th><strong>Specification<\/strong><\/th>\n<th><strong>Fluorescein Sodium Injection 10% &amp; 20%<\/strong><\/th>\n<\/tr>\n<\/thead>\n<tbody>\n<tr>\n<td><strong>Concentration<\/strong><\/td>\n<td>IP 10%\u00a0 and 20%<\/td>\n<\/tr>\n<tr>\n<td><strong>Active Ingredient<\/strong><\/td>\n<td>Fluorescein Sodium<\/td>\n<\/tr>\n<tr>\n<td><strong>Form<\/strong><\/td>\n<td>Solution for injection<\/td>\n<\/tr>\n<tr>\n<td><strong>Administration Route<\/strong><\/td>\n<td>Intravenous<\/td>\n<\/tr>\n<tr>\n<td><strong>Indications<\/strong><\/td>\n<td>Fluorescein angiography, angioscopy<\/td>\n<\/tr>\n<tr>\n<td><strong>Appearance<\/strong><\/td>\n<td>Clear, yellow-orange solution<\/td>\n<\/tr>\n<tr>\n<td><strong>Packaging<\/strong><\/td>\n<td>Single-dose vial<\/td>\n<\/tr>\n<tr>\n<td><strong>Volume<\/strong><\/td>\n<td>Typically 5 mL or 10 mL<\/td>\n<\/tr>\n<tr>\n<td><strong>pH Range<\/strong><\/td>\n<td>8.0 &#8211; 9.8<\/td>\n<\/tr>\n<tr>\n<td><strong>Osmolality<\/strong><\/td>\n<td>Approximately 572 mOsm\/kg (10%), 1440 mOsm\/kg (20%)<\/td>\n<\/tr>\n<tr>\n<td><strong>Storage Conditions<\/strong><\/td>\n<td>Store at 2\u00b0C &#8211; 25\u00b0C (36\u00b0F &#8211; 77\u00b0F)<\/td>\n<\/tr>\n<tr>\n<td><strong>Shelf Life<\/strong><\/td>\n<td>24 months<\/td>\n<\/tr>\n<\/tbody>\n<\/table>\n<p>&nbsp;<\/p>\n","protected":false},"excerpt":{"rendered":"<p>Fluorescein Sodium Injection is a diagnostic agent used in fluorescein angiography or angioscopy of the fundus and iris vasculature in ophthalmic practices. It helps in visualizing the blood vessels in the back of the eye to diagnose conditions such as diabetic retinopathy, macular degeneration, and other retinal disorders. Available in concentrations of 10% and 20%, this injection is administered intravenously, and its fluorescent properties illuminate the retinal blood vessels under a specialized light.<\/p>\n","protected":false},"featured_media":19635,"comment_status":"open","ping_status":"closed","template":"","meta":[],"product_brand":[],"product_cat":[78],"product_tag":[],"class_list":["post-19630","product","type-product","status-publish","has-post-thumbnail","product_cat-ophthalmic-solutions","first","instock","shipping-taxable","product-type-simple"],"_links":{"self":[{"href":"https:\/\/centralindiaexport.com\/wp-json\/wp\/v2\/product\/19630","targetHints":{"allow":["GET"]}}],"collection":[{"href":"https:\/\/centralindiaexport.com\/wp-json\/wp\/v2\/product"}],"about":[{"href":"https:\/\/centralindiaexport.com\/wp-json\/wp\/v2\/types\/product"}],"replies":[{"embeddable":true,"href":"https:\/\/centralindiaexport.com\/wp-json\/wp\/v2\/comments?post=19630"}],"version-history":[{"count":4,"href":"https:\/\/centralindiaexport.com\/wp-json\/wp\/v2\/product\/19630\/revisions"}],"predecessor-version":[{"id":19636,"href":"https:\/\/centralindiaexport.com\/wp-json\/wp\/v2\/product\/19630\/revisions\/19636"}],"wp:featuredmedia":[{"embeddable":true,"href":"https:\/\/centralindiaexport.com\/wp-json\/wp\/v2\/media\/19635"}],"wp:attachment":[{"href":"https:\/\/centralindiaexport.com\/wp-json\/wp\/v2\/media?parent=19630"}],"wp:term":[{"taxonomy":"product_brand","embeddable":true,"href":"https:\/\/centralindiaexport.com\/wp-json\/wp\/v2\/product_brand?post=19630"},{"taxonomy":"product_cat","embeddable":true,"href":"https:\/\/centralindiaexport.com\/wp-json\/wp\/v2\/product_cat?post=19630"},{"taxonomy":"product_tag","embeddable":true,"hre